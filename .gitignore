# BinPack SDK .gitignore

# Build outputs
/build/
/bin/
/lib/
/out/
/target/
*.obj
*.o
*.pdb
*.idb
*.exp
*.ilk

# Executables & Dynamic Libs (built during testing/compilation)
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
!deps/lib/*.lib
!deps/lib/*.a
!integrations/unity/com.binpack.enterprise/Plugins/**/*.dll
!integrations/unity/com.binpack.enterprise/Plugins/**/*.so
!integrations/unity/com.binpack.enterprise/Plugins/**/*.dylib

# Temporary & Test files
*.tmp
*.bak
*.bpk
*.bpk2
*.binpack
test_output*
temp*

# IDE & OS files
.vscode/
.vs/
.idea/
.DS_Store
Thumbs.db
*.suo
*.user

# Python cache
__pycache__/
*.pyc
*.pyo

# Upstream clones
deps/zstd_src/


# Benchmark corpora (downloaded on demand via fetch_corpora.py)
tests/corpora/

# Rust build artifacts
Cargo.lock
